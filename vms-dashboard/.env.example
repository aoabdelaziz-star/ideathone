# Demo auth configuration — never commit real credentials or secrets.
# bcrypt hash of the demo password "admin123" (salt cost 12).
# Escape each "$" as "\$" so Vite's dotenv loader does not expand it.
VMS_DEMO_USERNAME=omar nad
VMS_PASSWORD_HASH=\$2b\$12\$bqzIUcFmKJUQjHvgwrr9TODhjeKGRKmZt1mJLpN1Sz1.hoi4kEL2y
VMS_SESSION_SECRET=replace-with-a-long-random-secret-before-deployment
